# -------------------------------------------------
#  Description:
#    This file provides the configuration for 'dialog' TUI widgets.
#    Customized for a clean "Linux Terminal" look: 
#    Black background, Green highlights (Cucumber style).
# -------------------------------------------------

# Set aspect-ratio.
aspect = 0

# Set separator (for multiple widgets output).
separate_widget = ""

# Set tab-length (for textbox tab-conversion).
tab_len = 0

# Make tab-traversal for checklist, etc., include the list.
visit_items = OFF

# Show scrollbar in dialog boxes?
use_scrollbar = ON

# Shadow dialog boxes? (Turned OFF for clean terminal look)
use_shadow = OFF

# Turn color support ON or OFF
use_colors = ON

# Screen color (Background) - Black
screen_color = (WHITE,BLACK,OFF)

# Shadow color
shadow_color = (BLACK,BLACK,OFF)

# Dialog box color - Black background, White text
dialog_color = (WHITE,BLACK,OFF)

# Dialog box title color - Cucumber Green
title_color = (GREEN,BLACK,ON)

# Dialog box border color - Dark Grey/White
border_color = (WHITE,BLACK,ON)

# Active button color - Inverted Green
button_active_color = (BLACK,GREEN,ON)

# Inactive button color
button_inactive_color = (WHITE,BLACK,OFF)

# Active button key color
button_key_active_color = (BLACK,GREEN,ON)

# Inactive button key color - Red for hints
button_key_inactive_color = (RED,BLACK,OFF)

# Active button label color
button_label_active_color = (BLACK,GREEN,ON)

# Inactive button label color
button_label_inactive_color = (WHITE,BLACK,ON)

# Input box color
inputbox_color = (WHITE,BLACK,OFF)

# Input box border color
inputbox_border_color = (WHITE,BLACK,OFF)

# Search box color
searchbox_color = (WHITE,BLACK,OFF)

# Search box title color
searchbox_title_color = (GREEN,BLACK,ON)

# Search box border color
searchbox_border_color = (WHITE,BLACK,ON)

# File position indicator color
position_indicator_color = (GREEN,BLACK,ON)

# Menu box color
menubox_color = (WHITE,BLACK,OFF)

# Menu box border color
menubox_border_color = (WHITE,BLACK,ON)

# Item color
item_color = (WHITE,BLACK,OFF)

# Selected item color - Inverted Green
item_selected_color = (BLACK,GREEN,ON)

# Tag color - Cucumber Green
tag_color = (GREEN,BLACK,ON)

# Selected tag color
tag_selected_color = (BLACK,GREEN,ON)

# Tag key color
tag_key_color = (RED,BLACK,OFF)

# Selected tag key color
tag_key_selected_color = (BLACK,GREEN,ON)

# Check box color
check_color = (WHITE,BLACK,OFF)

# Selected check box color
check_selected_color = (BLACK,GREEN,ON)

# Up arrow color
uarrow_color = (GREEN,BLACK,ON)

# Down arrow color
darrow_color = (GREEN,BLACK,ON)

# Item help-text color
itemhelp_color = (WHITE,BLACK,OFF)

# Active form text color
form_active_text_color = (BLACK,GREEN,ON)

# Form text color
form_text_color = (WHITE,CYAN,ON)

# Readonly form item color
form_item_readonly_color = (CYAN,BLACK,ON)

# Dialog box gauge color - Green progress bar
gauge_color = (GREEN,BLACK,ON)

# Dialog box border2 color
border2_color = (WHITE,BLACK,ON)

# Input box border2 color
inputbox_border2_color = (WHITE,BLACK,ON)

# Search box border2 color
searchbox_border2_color = (WHITE,BLACK,ON)

# Menu box border2 color
menubox_border2_color = (WHITE,BLACK,ON)
