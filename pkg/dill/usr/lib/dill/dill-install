#!/bin/bash
#
##########################################################
#  Dill
#  System update utility for Arch-based Linux distros
#
#  Repository:
#    https://github.com/Pickles-Linux/pickles-update
#       To be moved to own Repor after 1st Stable Release
#
#  Author:
#    Stu Pickles
#    https://github.com/Stu-Pickles3047
#               for
#   Pickles Linux
#   https://github.com/Pickles-Linux/
#
#  License:
#    The Unlicense
#
# -------------------------------------------------
#  Description:
#    An update helper for Pickles Linux.
#    Designed for Humor, and future growth.
#   Designed as a complete AUR Helper, removing the need for Paru, yay or alternatives
#   dill is designed to be modular for easy update, ease of addition of extra scripts etc.
#
#   Rated R for Raunchy Aussie
#
#  Script Purpose:
#    This script handles installing packages.
#    It first checks the official repos, and if it's not found there,
#    it'll search the AUR.
# -------------------------------------------------
#Usage:
# dill install <package-name>
# dill install <part-package-name> tab completion similiar to Pacman (Create completion files for bash/fish/zsh )
# dill -S <package-name>
# dill -U <package>


# Source base utilities
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
source "$SCRIPT_DIR/dill-aur-library" # Sources dill-base

if [ -z "$1" ]; then
    error_log "Oi, what are ya tryin' to install? Usage: dill install <package-name>"
    exit 1
fi

for pkg in "$@"; do
    line_space
    info_log "$(printf "$MSG_INSTALL_START" "$pkg")"

    # 1. Check official repositories
    if pacman -Si "$pkg" &>/dev/null; then
        debug_log "$MSG_INSTALL_OFFICIAL"
        
        # Ask for confirmation
        read -p "$(info_log "$(printf "$MSG_PROCEED_ACTION" "install" "$pkg")")" -n 1 -r
        echo
        if [[ $REPLY =~ ^[Nn]$ ]]; then
            warn_log "Skipping '$pkg'."
            continue
        fi

        if sudo pacman -S --noconfirm "$pkg"; then
            success_log "$(printf "$MSG_INSTALL_SUCCESS" "$pkg")"
        else
            error_log "$(printf "$MSG_INSTALL_FAILED" "$pkg")"
        fi
    else
        # 2. Check AUR
        if aur_info "$pkg" &>/dev/null; then
            debug_log "$MSG_INSTALL_AUR"
            
            # Ask for confirmation
            read -p "$(info_log "$(printf "$MSG_PROCEED_ACTION" "install (AUR)" "$pkg")")" -n 1 -r
            echo
            if [[ $REPLY =~ ^[Nn]$ ]]; then
                warn_log "Skipping '$pkg'."
                continue
            fi

            # Use CACHE_DIR from config
            CACHE_DIR="${CACHE_DIR:-$HOME/.cache/dill}"
            pkg_cache="$CACHE_DIR/aur-$pkg"
            
            if aur_download "$pkg" "$pkg_cache"; then
                if aur_build "$pkg_cache"; then
                    pkgfile=$(ls "$pkg_cache"/*.pkg.tar.zst 2>/dev/null | head -1)
                    if [ -n "$pkgfile" ]; then
                        if aur_install "$pkgfile"; then
                            success_log "$(printf "$MSG_INSTALL_SUCCESS" "$pkg")"
                        else
                            error_log "$(printf "$MSG_INSTALL_FAILED" "$pkg")"
                        fi
                    else
                        error_log "Bugger, I built it but couldn't find the package file."
                        error_log "$(printf "$MSG_INSTALL_FAILED" "$pkg")"
                    fi
                else
                    error_log "$(printf "$MSG_INSTALL_FAILED" "$pkg")"
                fi
                
                # Cleanup if not keeping cache
                if [ "$KEEP_CACHE" != true ]; then
                    rm -rf "$pkg_cache"
                fi
            else
                error_log "$(printf "$MSG_INSTALL_FAILED" "$pkg")"
            fi
        else
            error_log "$(printf "$MSG_INSTALL_NOT_FOUND" "$pkg")"
        fi
    fi
done

exit 0
