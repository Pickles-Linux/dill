#   Rated R for Raunchy Aussie 
#
#  Script Purpose:
#    This script manages and updates the pacman mirrorlist by using
#    the 'rate-mirrors' utility to find the fastest servers.
# -------------------------------------------------

set -Eeuo pipefail

# ------------------------------
# Configuration Loading
# ------------------------------
# Get the directory of the main 'dill' executable
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
source "$SCRIPT_DIR/dill-base"

# Debug: Starting mirrorlist update
debug_log "$MSG_DEBUG_MIRRORLIST_START"

# Define the mapping of mirrorlist files to rate-mirrors providers
declare -A PROVIDER_MAP
PROVIDER_MAP["mirrorlist"]="arch"
# Add other mappings here if needed, e.g.
PROVIDER_MAP["chaotic-mirrorlist"]="chaotic-aur"


# ------------------------------
# Dependency Check
# ------------------------------
if ! command -v rate-mirrors &> /dev/null; then
    warn_log "$MSG_MIRRORLIST_MISSING_RATE_MIRRORS"
    read -p "$(info_log "$MSG_MIRRORLIST_INSTALL_PROMPT")" choice
    case "$choice" in
        y|Y|"")
            info_log "$MSG_MIRRORLIST_INSTALLING"
            sudo pacman -S --noconfirm rate-mirrors
            ;;
        *)
            error_log "$MSG_MIRRORLIST_INSTALL_CANCELLED"
            exit 1
            ;;
    esac
fi

# ------------------------------
# Mirrorlist Processing
# ------------------------------
MIRRORLIST_DIR="/etc/pacman.d"

section_log "$(printf "$MSG_MIRRORLIST_CHECKING_DIR" "$MIRRORLIST_DIR")"

for mirror_file in "${!PROVIDER_MAP[@]}"; do
    full_path="$MIRRORLIST_DIR/$mirror_file"

    if [[ -f "$full_path" ]]; then
        provider="${PROVIDER_MAP[$mirror_file]}"
        info_log "$(printf "$MSG_MIRRORLIST_FOUND" "$mirror_file" "$provider")"
        debug_log "$(printf "$MSG_DEBUG_MIRRORLIST_PROCESSING" "$mirror_file" "$provider")"

        # 1. Backup the existing mirrorlist (requires sudo)
        backup_path="$full_path.bak"
        info_log "$(printf "$MSG_MIRRORLIST_BACKING_UP" "$full_path" "$backup_path")"
        debug_log "$(printf "$MSG_DEBUG_MIRRORLIST_BACKUP" "$full_path")"
        sudo cp "$full_path" "$backup_path"

        # 2. Rate the mirrors (does not require sudo)
        info_log "$(printf "$MSG_MIRRORLIST_RATING" "$provider")"
        debug_log "$(printf "$MSG_DEBUG_MIRRORLIST_RATING" "$provider")"

        temp_output_file=$(mktemp)
        # Run rate-mirrors as the current user.
        # The pipefail option ensures that if rate-mirrors fails, the condition is met.
        if ! rate-mirrors "$provider" 2>&1 | tee /dev/stderr > "$temp_output_file"; then
            error_log "$(printf "$MSG_MIRRORLIST_ERROR_RATE_FAILED" "$provider")"
            sudo mv "$backup_path" "$full_path"
            rm -f "$temp_output_file"
            exit 1
        fi

        # Grep the server lines from the output file.
        rated_mirrors=$(grep -E '^Server' "$temp_output_file" || true)
        rm -f "$temp_output_file"

        if [[ -z "$rated_mirrors" ]]; then
            error_log "$(printf "$MSG_MIRRORLIST_ERROR_NO_SERVERS" "$provider")"
            sudo mv "$backup_path" "$full_path"
            exit 1
        fi

        # 3. Prepare the new mirrorlist content
        temp_file=$(mktemp)
        cat > "$temp_file" <<-EOF
### '$mirror_file' ###
## Created by dill ##
## with rate-mirrors ##

# Mirrorlist
$rated_mirrors
EOF

        # 4. Overwrite the original mirrorlist (requires sudo)
        info_log "$(printf "$MSG_MIRRORLIST_UPDATING" "$full_path")"
        debug_log "$(printf "$MSG_DEBUG_MIRRORLIST_UPDATING" "$full_path")"
        sudo mv "$temp_file" "$full_path"

        success_log "$(printf "$MSG_MIRRORLIST_SUCCESS" "$mirror_file")"
    else
        warn_log "$(printf "$MSG_MIRRORLIST_SKIPPING" "$mirror_file")"
    fi
done

success_log "$MSG_MIRRORLIST_COMPLETE"
exit 0
