#   
#   Rated R for Raunchy Aussie 
#
#  Script Purpose:
#    This script displays the visual header (the 'Dill' logo) 
#    using the color configured in the settings.
#
# Usage:
#   dill-header
# -------------------------------------------------

# Source base utilities
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
source "$SCRIPT_DIR/dill-base"

# Normalise to lowercase
case "${HEADER_COLOR,,}" in
    black)   LOGO_COLOR='\033[30m' ;;
    red)     LOGO_COLOR='\033[31m' ;;
    green)   LOGO_COLOR='\033[32m' ;;
    yellow)  LOGO_COLOR='\033[33m' ;;
    blue)    LOGO_COLOR='\033[34m' ;;
    magenta) LOG_COLOR='\033[35m' ;;
    cyan)    LOGO_COLOR='\033[36m' ;;
    white)   LOGO_COLOR='\033[37m' ;;
    *)       LOGO_COLOR='\033[32m' ;; # fallback green
esac

line_space
# Apply colour
printf "%b" "$LOGO_COLOR"

cat <<'EOF'
    ██████╗ ██╗██╗     ██╗     
    ██╔══██╗██║██║     ██║     
    ██║  ██║██║██║     ██║     
    ██║  ██║██║██║     ██║     
    ██████╔╝██║███████╗███████╗
    ╚═════╝ ╚═╝╚══════╝╚══════╝
EOF

# Reset terminal colour
printf "%b\n" "$RESET"
