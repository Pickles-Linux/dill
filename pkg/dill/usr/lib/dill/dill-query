#  Description:
#    An update helper for Pickles Linux.
#    Designed for Humor, and future growth.
#   Designed as a complete AUR Helper, removing the need for Paru, yay or alternatives
#   dill is designed to be modular for easy update, ease of addition of extra scripts etc.
#
#   Rated R for Raunchy Aussie
#
#  Script Purpose:
#    This script is for searching for packages, both locally installed
#    and in the repositories/AUR.
# -------------------------------------------------

# Source base utilities
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
source "$SCRIPT_DIR/dill-aur-library" # Sources dill-base

# Function to search installed packages
search_installed() {
    local query="$1"
    pacman -Q | grep -i "$query"
}

# Function to search official repos
search_official() {
    local query="$1"
    pacman -Ss "$query" | grep "^[^ ]" | head -20
}

# Function to display results with numbers
display_results() {
    local results="$1"
    local type="$2"
    section_log "Results from $type"
    echo "$results" | nl -v1
    line_space
}

# Function to show package info
show_info() {
    local pkg="$1"
    local type="$2"
    if [ "$type" = "installed" ]; then
        pacman -Qi "$pkg"
    elif [ "$type" = "official" ]; then
        pacman -Si "$pkg"
    elif [ "$type" = "aur" ]; then
        aur_info "$pkg"
    fi
}

# Function to offer actions
offer_actions() {
    local pkg="$1"
    local type="$2"
    info_log "$(printf "$MSG_QUERY_ACTIONS" "$pkg")"
    if [ "$type" = "installed" ]; then
        echo "  $MSG_QUERY_ACTION_REMOVE"
    else
        echo "  $MSG_QUERY_ACTION_INSTALL"
    fi
    echo "  $MSG_QUERY_ACTION_INFO"
    echo "  $MSG_QUERY_ACTION_EXIT"
    read -r choice
    case "$choice" in
        1)
            if [ "$type" = "installed" ]; then
                read -p "$(info_log "$(printf "$MSG_PROCEED_ACTION" "remove" "$pkg")")" -n 1 -r
                echo
                if [[ $REPLY =~ ^[Nn]$ ]]; then
                    warn_log "Cancelled."
                    return
                fi
                info_log "$(printf "$MSG_REMOVE_START" "$pkg")"
                sudo pacman -Rns --noconfirm "$pkg"
            else
                local action_label="install"
                [ "$type" = "aur" ] && action_label="install (AUR)"
                read -p "$(info_log "$(printf "$MSG_PROCEED_ACTION" "$action_label" "$pkg")")" -n 1 -r
                echo
                if [[ $REPLY =~ ^[Nn]$ ]]; then
                    warn_log "Cancelled."
                    return
                fi
                info_log "$(printf "$MSG_INSTALL_START" "$pkg")"
                if [ "$type" = "official" ]; then
                    sudo pacman -S --noconfirm "$pkg"
                elif [ "$type" = "aur" ]; then
                    # Build and install from AUR
                    CACHE_DIR="${CACHE_DIR:-$HOME/.cache/dill}"
                    pkg_cache="$CACHE_DIR/aur-$pkg"
                    if aur_download "$pkg" "$pkg_cache"; then
                        if aur_build "$pkg_cache"; then
                            pkgfile=$(ls "$pkg_cache"/*.pkg.tar.zst 2>/dev/null | head -1)
                            if [ -n "$pkgfile" ]; then
                                aur_install "$pkgfile"
                            fi
                        fi
                        if [ "$KEEP_CACHE" != true ]; then
                            rm -rf "$pkg_cache"
                        fi
                    fi
                fi
            fi
            ;;
        2)
            show_info "$pkg" "$type"
            ;;
        *)
            info_log "Alright, exiting."
            ;;
    esac
}

# Parse arguments
MODE=""
QUERY=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -Q|--installed)
            MODE="installed"
            shift
            ;;
        -S|--search)
            MODE="search"
            shift
            ;;
        *)
            QUERY="$1"
            shift
            ;;
    esac
done

if [ -z "$QUERY" ]; then
    error_log "Oi, what are ya lookin' for? Usage: dill query [-Q|-S] <query>"
    exit 1
fi

info_log "$(printf "$MSG_QUERY_START" "$QUERY")"

if [ "$MODE" = "installed" ] || [ -z "$MODE" ]; then
    RESULTS=$(search_installed "$QUERY")
    if [ -n "$RESULTS" ]; then
        display_results "$RESULTS" "installed packages"
        echo -e "${BOLD}$MSG_QUERY_SELECT${RESET}"
        read -r selection
        if [ -n "$selection" ] && [[ "$selection" =~ ^[0-9]+$ ]]; then
            PKG=$(echo "$RESULTS" | sed -n "${selection}p" | awk '{print $1}')
            if [ -n "$PKG" ]; then
                offer_actions "$PKG" "installed"
            fi
        fi
    else
        debug_log "No installed packages match '$QUERY'."
    fi
fi

if [ "$MODE" = "search" ] || [ -z "$MODE" ]; then
    # Search official repos
    OFFICIAL_RESULTS=$(search_official "$QUERY")
    if [ -n "$OFFICIAL_RESULTS" ]; then
        display_results "$OFFICIAL_RESULTS" "official repos"
        echo -e "${BOLD}$MSG_QUERY_SELECT${RESET}"
        read -r selection
        if [ -n "$selection" ] && [[ "$selection" =~ ^[0-9]+$ ]]; then
            PKG=$(echo "$OFFICIAL_RESULTS" | sed -n "${selection}p" | cut -d'/' -f2 | cut -d' ' -f1)
            if [ -n "$PKG" ]; then
                offer_actions "$PKG" "official"
            fi
        fi
    fi

    # Search AUR
    AUR_RESULTS=$(aur_search "$QUERY")
    if [ -n "$AUR_RESULTS" ] && [ "$AUR_RESULTS" != "null" ]; then
        display_results "$AUR_RESULTS" "AUR"
        echo -e "${BOLD}$MSG_QUERY_SELECT${RESET}"
        read -r selection
        if [ -n "$selection" ] && [[ "$selection" =~ ^[0-9]+$ ]]; then
            PKG=$(echo "$AUR_RESULTS" | sed -n "${selection}p" | cut -d: -f1)
            if [ -n "$PKG" ]; then
                offer_actions "$PKG" "aur"
            fi
        fi
    fi

    if [ -z "$OFFICIAL_RESULTS" ] && { [ -z "$AUR_RESULTS" ] || [ "$AUR_RESULTS" == "null" ]; }; then
        error_log "$(printf "$MSG_QUERY_NO_RESULTS" "$QUERY")"
    fi
fi

exit 0
