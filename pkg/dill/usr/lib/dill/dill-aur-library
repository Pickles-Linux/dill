# Source base utilities
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
source "$SCRIPT_DIR/dill-base"

# Function to search AUR
aur_search() {
    local query="$1"
    if [ -z "$query" ]; then
        error_log "No search query provided"
        return 1
    fi
    debug_log "Searching AUR for '$query'"
    local response=$(curl -s "https://aur.archlinux.org/rpc/?v=5&type=search&arg=$query")
    # Check if jq is available
    if command -v jq >/dev/null 2>&1; then
        echo "$response" | jq -r '.results[] | "\(.Name): \(.Version) - \(.Description)"' 2>/dev/null
    else
        debug_log "jq not available, raw response: $response"
        echo "$response"
    fi
}

# Function to get info
aur_info() {
    local pkg="$1"
    if [ -z "$pkg" ]; then
        error_log "No package name provided"
        return 1
    fi
    local response=$(curl -s "https://aur.archlinux.org/rpc/?v=5&type=info&arg=$pkg")
    if command -v jq >/dev/null 2>&1; then
        echo "$response" | jq '.results[0] // empty' 2>/dev/null
    else
        echo "$response"
    fi
}

# Function to get version
aur_get_version() {
    local pkg="$1"
    local response=$(curl -s "https://aur.archlinux.org/rpc/?v=5&type=info&arg=$pkg")
    if command -v jq >/dev/null 2>&1; then
        echo "$response" | jq -r '.results[0].Version // empty' 2>/dev/null
    else
        # Simple parsing
        echo "$response" | grep -o '"Version":"[^"]*"' | cut -d'"' -f4
    fi
}

# Function to download PKGBUILD
aur_download() {
    local pkg="$1"
    local dest="${2:-/tmp/aur-$pkg}"
    if [ -z "$pkg" ]; then
        error_log "No package name provided"
        return 1
    fi
    debug_log "Downloading $pkg to $dest"
    if [ -d "$dest" ]; then
        rm -rf "$dest"
    fi
    git clone "https://aur.archlinux.org/$pkg.git" "$dest" 2>/dev/null
    if [ $? -eq 0 ]; then
        success_log "Downloaded $pkg to $dest"
    else
        error_log "Failed to download $pkg"
        return 1
    fi
}

# Function to build package
aur_build() {
    local dir="$1"
    if [ -z "$dir" ] || [ ! -d "$dir" ]; then
        error_log "Invalid directory $dir"
        return 1
    fi
    debug_log "Building package in $dir"
    cd "$dir"
    makepkg -s --noconfirm
    if [ $? -eq 0 ]; then
        success_log "Built package in $dir"
    else
        error_log "Failed to build package"
        return 1
    fi
}

# Function to install package
aur_install() {
    local pkgfile="$1"
    if [ -z "$pkgfile" ] || [ ! -f "$pkgfile" ]; then
        error_log "Invalid package file $pkgfile"
        return 1
    fi
    debug_log "Installing $pkgfile"
    sudo pacman -U "$pkgfile" --noconfirm
    if [ $? -eq 0 ]; then
        success_log "Installed $pkgfile"
    else
        error_log "Failed to install $pkgfile"
        return 1
    fi
}

# Function to check for AUR updates
aur_check_updates() {
    local foreign=$(pacman -Qm 2>/dev/null)
    local updates=()
    while read -r pkg ver; do
        if [ -z "$pkg" ]; then continue; fi
        local aur_ver=$(aur_get_version "$pkg")
        if [ -n "$aur_ver" ] && [ "$ver" != "$aur_ver" ]; then
            updates+=("$pkg $ver -> $aur_ver")
        fi
    done <<< "$foreign"
    if [ ${#updates[@]} -gt 0 ]; then
        printf '%s\n' "${updates[@]}"
    else
        echo "No AUR updates available"
    fi
}

# Function to import PGP key
aur_import_pgp() {
    local key="$1"
    if [ -z "$key" ]; then
        echo "Error: No key provided"
        return 1
    fi
    gpg --recv-keys "$key" 2>/dev/null
    if [ $? -eq 0 ]; then
        echo "Imported PGP key $key"
    else
        echo "Error: Failed to import PGP key $key"
        return 1
    fi
}
